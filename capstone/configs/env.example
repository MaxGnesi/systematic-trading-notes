# Copy to capstone/configs/.env (git-ignored) and fill in. Never commit the real file.
# Step 1 needs nothing here: public market data needs no account.

# Where the bot keeps its records. Default: a SQLite file in capstone/data/.
# DATABASE_URL=sqlite:///capstone/data/capstone.db
# DATABASE_URL=postgresql://capstone_app@localhost/capstone      (password in PGPASSWORD, never in the URL)

# From step 2 on: a FREE Deribit TESTNET account (test.deribit.com) and an API key you create there,
# with account read and trade permissions only, never withdrawals.
# Preferred: a key pair you generate yourself (Ed25519); Deribit then holds only the public key.
# DERIBIT_ENV=testnet
# DERIBIT_CLIENT_ID=
# DERIBIT_PRIVATE_KEY_PATH=          # path to your Ed25519 private key, outside the repository
# DERIBIT_CLIENT_SECRET=             # only for a Deribit-generated (HMAC) key, the fallback

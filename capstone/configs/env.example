# Copy to capstone/configs/.env (git-ignored) and fill in. Never commit the real file.
# Step 1 needs nothing here: public market data needs no account.

# Where the bot keeps its records. Default: a SQLite file in capstone/data/.
# DATABASE_URL=sqlite:///capstone/data/capstone.db
# DATABASE_URL=postgresql://capstone_app@localhost/capstone      (password in PGPASSWORD, never in the URL)

# From step 2 on: a FREE Bybit TESTNET account (testnet.bybit.com) and an API key you create there,
# with read and contract-trade permissions only, never withdrawals.
# BYBIT_ENV=testnet
# BYBIT_API_KEY=
# BYBIT_API_SECRET=                 # for a system-generated (HMAC) key
# BYBIT_PRIVATE_KEY_PATH=           # for a self-generated key pair: path to the private key, outside the repo

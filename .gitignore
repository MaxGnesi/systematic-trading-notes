__pycache__/
*.pyc
.ipynb_checkpoints/
/data/
/figures/
*.egg-info/
.venv/
venv/

# interactive chart exports are regenerated by the notebooks; only PNGs are committed
lectures/*/figures/*.html
lectures/*/figures/plotly.min.js

# secrets: API keys live in the environment or in .env files, never in the repository
.env
*.env

# notebook charts are embedded in the notebooks; only the lectures' own figures are committed
lectures/*/figures/nb_*
lectures/*/figures/12_nb_*
